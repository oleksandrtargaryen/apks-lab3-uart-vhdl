# Призначення виводів для Lattice iCE40-HX8K (корпус CT256),
# розводка за платою iCE40-HX8K Breakout Board.
# Лабораторна робота №3, Бартошко О.І., КІ-408.
#
# Увага: на Breakout Board штатний генератор 12 МГц (J3). Проєкт розраховано
# на зовнішній генератор 50 МГц, поданий на той самий вивід J3
# (або змініть generic CLK_FREQ у synth/run_synth.sh).

set_io clk    J3           # системний такт
set_io -pullup yes rst_n N3  # кнопка скидання (активний '0'), вивід роз'єму
set_io rx     B10          # RS232_Rx_TTL — від FTDI FT2232H (канал B)
set_io tx     B12          # RS232_Tx_TTL — до FTDI FT2232H
set_io led[0] B5
set_io led[1] B4
set_io led[2] A2
set_io led[3] A1
set_io led[4] C5
set_io led[5] C4
set_io led[6] B3
set_io led[7] C3
